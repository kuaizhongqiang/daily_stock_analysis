# ===================================
# 股票智能分析系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实配置
# Fork: 默认使用本地 LM Studio，无需云 API Key
# ===================================

# ===================================
# LLM 配置（默认本地 LM Studio）
# ===================================
# LM Studio 本地模型（推荐，无需 API Key）
# 启动 LM Studio 后加载模型，开启 LLM Server（默认 http://localhost:1234/v1）
LLM_CHANNELS=lm_studio
LLM_LM_STUDIO_PROTOCOL=openai
LLM_LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLM_LM_STUDIO_MODELS=qwen/qwen3.5-9b
LLM_LM_STUDIO_API_KEY=not-needed
LITELLM_MODEL=openai/qwen/qwen3.5-9b

# 本地模型超时（秒）：单只股票分析 LLM 耗时可达 3-4 分钟
# LLM_TIMEOUT_SEC=600

# 采样温度（0.0-2.0，默认 0.7）
# LLM_TEMPERATURE=0.7

# ===================================
# 自选股
# ===================================
# 逗号分隔，支持沪深两市、港股、美股
STOCK_LIST=600519,300750,002594

# ===================================
# 数据源配置
# ===================================
# Tushare Pro Token（可选，A 股数据增强）
# 获取: https://tushare.pro
TUSHARE_TOKEN=

# Longbridge OpenAPI（可选，美股/港股量比、换手率等字段补充）
# 获取: https://open.longbridge.com/
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# Legacy API Key:
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=

# TickFlow API Key（可选，A 股大盘复盘指数增强）
# TICKFLOW_API_KEY=

# Finnhub（可选，美股数据，免费 tier 60 calls/min）
# FINNHUB_API_KEY=

# AlphaVantage（可选，美股数据，免费 tier 25 calls/day）
# ALPHAVANTAGE_API_KEY=

# ===================================
# 搜索引擎（用于获取股票新闻）
# ===================================
# Bocha API Keys（中文搜索优化，支持多个，逗号分隔）
# BOCHA_API_KEYS=
# Tavily API Keys（支持多个，逗号分隔）
# TAVILY_API_KEYS=
# SerpAPI Keys（支持多个，逗号分隔）
# SERPAPI_API_KEYS=
# Brave Search API Keys（支持多个，逗号分隔）
# BRAVE_API_KEYS=
# SearXNG 实例地址（逗号分隔，私有部署无配额）
# SEARXNG_BASE_URLS=
# SEARXNG_PUBLIC_INSTANCES_ENABLED=true

# ===================================
# Agent 策略对话配置
# ===================================
# 启用 Agent 策略对话（默认 false）
# AGENT_MODE=true
# Agent 主模型（留空继承主模型）
# AGENT_LITELLM_MODEL=
# Agent 最大推理步数上限
# AGENT_MAX_STEPS=10

# 默认启用策略（逗号分隔，留空使用 bull_trend）
# 内置策略: bull_trend, ma_golden_cross, volume_breakout, hot_theme,
#           event_driven, growth_quality, expectation_repricing,
#           shrink_pullback, bottom_volume, dragon_head, chan_theory,
#           wave_theory, emotion_cycle, box_oscillation, one_yang_three_yin
# AGENT_SKILLS=
# 完整启用所有内置策略：
# AGENT_SKILLS=all

# Agent 架构模式（single / multi）
# AGENT_ARCH=single
# Multi-Agent 编排模式（quick / standard / full / specialist）
# AGENT_ORCHESTRATOR_MODE=standard
# Agent 执行超时预算（秒，0 关闭，默认 600）
# AGENT_ORCHESTRATOR_TIMEOUT_S=600
# 风控 Agent 是否可以否决买入信号
# AGENT_RISK_OVERRIDE=true
# 策略路由模式（auto / manual）
# AGENT_SKILL_ROUTING=auto

# ===================================
# 数据库配置
# ===================================
DATABASE_PATH=./data/stock_analysis.db
# SQLite WAL 模式（降低锁竞争）
SQLITE_WAL_ENABLED=true
# SQLite 等锁超时（毫秒）
SQLITE_BUSY_TIMEOUT_MS=5000
# 分析历史快照持久化
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# 回测配置
# ===================================
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=10
BACKTEST_MIN_AGE_DAYS=14
BACKTEST_NEUTRAL_BAND_PCT=2.0

# ===================================
# 大盘复盘
# ===================================
MARKET_REVIEW_ENABLED=true
# 市场区域：cn（A股）, hk（港股）, us（美股）, both（全部）
# MARKET_REVIEW_REGION=cn
# 涨跌颜色：green_up（绿涨红跌）, red_up（红涨绿跌）
# MARKET_REVIEW_COLOR_SCHEME=green_up

# ===================================
# 代理配置
# ===================================
# 仅在本地开发环境生效，GitHub Actions 自动跳过
USE_PROXY=false
# PROXY_HOST=127.0.0.1
# PROXY_PORT=10809

# ===================================
# 系统配置
# ===================================
LOG_DIR=./logs
LOG_LEVEL=INFO
# 最大并发线程数
MAX_WORKERS=3
DEBUG=false

# ===================================
# 数据源优先级配置
# ===================================
# 数据抓取优先级（数值越低越优先）
# EFINANCE_PRIORITY=0
# AKSHARE_PRIORITY=1
# TUSHARE_PRIORITY=2
# PYTDX_PRIORITY=2
# BAOSTOCK_PRIORITY=3
# YFINANCE_PRIORITY=4

# 实时行情数据源优先级
# REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# 筹码分布（云端接口不稳定，默认关闭）
# ENABLE_CHIP_DISTRIBUTION=false
# 基本面聚合
# ENABLE_FUNDAMENTAL_PIPELINE=true

# ===================================
# 向量搜索配置（第二期）
# ===================================
# 嵌入提供者: local(LM Studio 本地) / remote(云端 API)
# EMBEDDING_PROVIDER=local
# LM Studio 嵌入端点（确保已加载 embedding 模型）
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# embedding 模型名（需与 LM Studio 加载的模型一致）
# EMBEDDING_MODEL=text-embedding-baai-bge-m3-568m
# 向量维度（bge-m3 为 1024）
# EMBEDDING_DIMENSION=1024
# Remote 模式 API Key
# EMBEDDING_API_KEY=not-needed
# 请求超时（秒）
# EMBEDDING_TIMEOUT=30

# 向量索引分块大小（字符数）
# VECTOR_CHUNK_SIZE=512
# 分块重叠（字符数）
# VECTOR_CHUNK_OVERLAP=64
# 默认返回 Top-K 结果数
# VECTOR_TOP_K=10
# 最低相似度阈值
# VECTOR_SIMILARITY_THRESHOLD=0.0
# 向量数据存储目录
# VECTOR_DATA_DIR=./data/vectors
